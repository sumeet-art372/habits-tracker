generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  name           String
  habits         Habit[]
  certifications Certification[]
  createdAt      DateTime        @default(now())
}

model Habit {
  id        Int     @id @default(autoincrement())
  title     String
  icon      String
  category  String
  streak    Int     @default(0)
  completed Boolean @default(false)
  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Certification {
  id       Int    @id @default(autoincrement())
  title    String
  status   String
  progress Int    @default(0)
  modules  String
  provider String
  target   String
  userId   Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
